# Supabase project settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin login password (choose your own strong password)
ADMIN_PASSWORD=change_this_password

# Random long random strings, used to sign admin sessions and Telegram
# approve/reject links. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_random_string
CALLBACK_SECRET=replace_with_another_random_string

# Telegram bot (message @BotFather to create one, then message @userinfobot
# or your bot once to find your numeric chat id)
TG_BOT_TOKEN=123456789:your_bot_token
TG_CHAT_ID=your_numeric_chat_id

# Optional: shared secret your SMS-forwarding app must send so /api/sms-webhook
# only accepts requests from your own phone
SMS_WEBHOOK_SECRET=replace_with_another_random_string
